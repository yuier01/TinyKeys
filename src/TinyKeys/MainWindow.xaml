<Window x:Class="TinyKeys.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TinyKeys.Controls"
        Title="TinyKeys"
        Width="464"
        Height="176"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="False"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#20242B" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7C8490" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA1AC" />
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#C24A5A" />

        <Style x:Key="KeyButtonStyle" TargetType="{x:Type controls:HoldButton}">
            <Setter Property="Background" Value="#F8F9FB" />
            <Setter Property="BorderBrush" Value="#E8EBF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="76" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:HoldButton}">
                        <Grid>
                            <Border x:Name="KeyEdge"
                                    Background="#E7EAF0"
                                    CornerRadius="14"
                                    Margin="0,2,0,0" />
                            <Border x:Name="Keycap"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    Margin="0,0,0,2">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Keycap" Property="Background" Value="#F1F4F8" />
                                <Setter TargetName="KeyEdge" Property="Background" Value="#E0E4EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Keycap" Property="Background" Value="#E9EDF3" />
                            </Trigger>
                            <Trigger Property="IsHeld" Value="True">
                                <Setter TargetName="Keycap" Property="Background" Value="#E9EDF3" />
                                <Setter TargetName="KeyEdge" Property="Background" Value="#DDE2E9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8A919C" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#F2F4F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#E9EDF3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTip" Value="置顶窗口" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PinSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <!-- Pin path from Microsoft Fluent UI System Icons (MIT). -->
                            <Viewbox Width="13"
                                     Height="13"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path x:Name="PinGlyph"
                                      Fill="#8A919C"
                                      Data="M16.2425 2.93189 L21.0682 7.75765 C22.3955 9.08491 22.0324 11.3224 20.3535 12.1619 L15.4826 14.5973 C15.3073 14.685 15.1732 14.8379 15.1092 15.0232 L13.6699 19.1895 C13.3684 20.0622 12.2574 20.3181 11.6045 19.6653 L8.50002 16.5607 L4.06074 21.0001 H3 L3.00008 19.9394 L7.43936 15.5001 L4.33487 12.3956 C3.682 11.7427 3.93791 10.6317 4.81061 10.3302 L8.97688 8.89096 C9.16223 8.82694 9.31512 8.69287 9.40281 8.51748 L11.8382 3.6466 C12.6777 1.96772 14.9152 1.60462 16.2425 2.93189 Z M20.0076 8.81831 L15.1818 3.99255 C14.5785 3.38924 13.5614 3.55429 13.1799 4.31742 L10.7445 9.18829 C10.4814 9.71446 10.0227 10.1167 9.46666 10.3087 L5.67812 11.6175 L12.3826 18.322 L13.6914 14.5335 C13.8835 13.9774 14.2857 13.5188 14.8118 13.2557 L19.6827 10.8202 C20.4458 10.4387 20.6109 9.42161 20.0076 8.81831 Z" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PinSurface" Property="Background" Value="#F2F4F7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PinSurface" Property="Background" Value="#FFF0F4" />
                                <Setter TargetName="PinGlyph" Property="Fill" Value="#E75F87" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeZoneStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF6F8" />
            <Setter Property="BorderBrush" Value="#FBE7ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF0F4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Margin="12"
                Background="#FFFFFF"
                BorderBrush="#E7E9EF"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect Color="#172033"
                                  BlurRadius="18"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.16" />
            </Border.Effect>

            <Grid Margin="16,10,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="76" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="14" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Background="Transparent"
                          Cursor="SizeAll"
                          MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <TextBlock Text="TinyKeys"
                                   Foreground="#5D6673"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ToggleButton x:Name="PinButton"
                                      Style="{StaticResource PinToggleStyle}"
                                      IsChecked="False"
                                      ToolTip="置顶窗口"
                                      AutomationProperties.Name="切换窗口置顶"
                                      Checked="PinButton_StateChanged"
                                      Unchecked="PinButton_StateChanged" />
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Content="−"
                                FontSize="14"
                                Margin="2,0,0,0"
                                ToolTip="最小化"
                                AutomationProperties.Name="最小化 TinyKeys"
                                Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Content="✕"
                                Margin="2,0,0,0"
                                ToolTip="退出"
                                AutomationProperties.Name="退出 TinyKeys"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:HoldButton x:Name="BackButton"
                                         Grid.Column="0"
                                         Style="{StaticResource KeyButtonStyle}"
                                         VirtualKey="37"
                                         ToolTip="后退：左方向键（短按后退，长按快速回退）"
                                         AutomationProperties.Name="后退，左方向键，长按快速回退"
                                         PreviewMouseLeftButtonDown="KeyButton_PreviewMouseLeftButtonDown">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="←"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="#20242B"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="后退"
                                       FontSize="10"
                                       Foreground="#838B97"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </controls:HoldButton>

                    <controls:HoldButton x:Name="PlayPauseButton"
                                         Grid.Column="2"
                                         Style="{StaticResource KeyButtonStyle}"
                                         VirtualKey="32"
                                         ToolTip="播放 / 暂停：空格键"
                                         AutomationProperties.Name="播放或暂停，空格键"
                                         PreviewMouseLeftButtonDown="KeyButton_PreviewMouseLeftButtonDown">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="空格"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#20242B"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="播放 / 暂停"
                                       FontSize="10"
                                       Foreground="#838B97"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </controls:HoldButton>

                    <controls:HoldButton x:Name="ForwardButton"
                                         Grid.Column="4"
                                         Style="{StaticResource KeyButtonStyle}"
                                         VirtualKey="39"
                                         ToolTip="前进：右方向键（短按快进，长按 2 倍速）"
                                         AutomationProperties.Name="前进，右方向键，长按 2 倍速"
                                         PreviewMouseLeftButtonDown="KeyButton_PreviewMouseLeftButtonDown">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="→"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="#20242B"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="前进"
                                       FontSize="10"
                                       Foreground="#838B97"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </controls:HoldButton>

                    <Border Grid.Column="5"
                            Width="1"
                            Background="#ECEEF2"
                            HorizontalAlignment="Center"
                            Margin="0,10" />

                    <Border x:Name="VolumeZone"
                            Grid.Column="6"
                            Style="{StaticResource VolumeZoneStyle}"
                            ToolTip="滚动鼠标滚轮调节 Windows 系统音量"
                            AutomationProperties.Name="音量，滚动鼠标滚轮调节"
                            MouseLeave="VolumeZone_MouseLeave"
                            MouseWheel="VolumeZone_MouseWheel">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="34"
                                    Height="34"
                                    Background="#FFE8EF"
                                    CornerRadius="17"
                                    HorizontalAlignment="Center">
                                <Viewbox Width="17" Height="17">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#FB7299"
                                              Data="M3 9 H7 L12 4 V20 L7 15 H3 Z" />
                                        <Path Stroke="#FB7299"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M15 9 C16.7 10.4 16.7 13.6 15 15" />
                                        <Path Stroke="#FB7299"
                                              StrokeThickness="1.7"
                                              Opacity="0.65"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M18 6.5 C21 9.5 21 14.5 18 17.5" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="音量"
                                       FontSize="10"
                                       Foreground="#838B97"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="HintText"
                           Grid.Row="4"
                           Text="长按保持按键 · 滚轮调节系统音量"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
